# ==============================================================================
# CLIENT COLLABORATION SAAS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for development
# ==============================================================================

# NEXT.JS APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# SUPABASE CREDENTIALS (Configure with your new dedicated project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# VERCEL PREVIEW API INTEGRATION
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
# Comma-separated list of allowed deployment host patterns for previews
ALLOWED_PREVIEW_HOSTS=.vercel.app,.nexus-clients.com

# PAYMENT GATEWAYS (STRIPE & RAZORPAY)
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MANAGED VIDEO PROVIDER (LIVEKIT)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://demo.livekit.cloud
